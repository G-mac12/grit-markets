# ---- Supabase (new dedicated project — do not reuse other Grit Agility instances)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the subscription products mirroring content/pricing.ts tiers
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=

# ---- Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Grit Markets <no-reply@gritmarkets.com>"

# ---- Telemetry & cron
# 32 bytes hex (openssl rand -hex 32): encrypts per-license telemetry secrets
TELEMETRY_SECRET_KEY=
# Vercel Cron auth (Vercel sends it as a Bearer token automatically)
CRON_SECRET=

# ---- Search / AEO
# IndexNow key (any 32-hex string): instant indexing pings to Bing/Yandex,
# which feed ChatGPT search and Copilot. Served at /indexnow.txt.
INDEXNOW_KEY=
# Optional meta-tag verification (DNS verification works without these)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Site
NEXT_PUBLIC_SITE_URL=https://gritmarkets.com
